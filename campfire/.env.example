# 复制为 .env 再填写（cp .env.example .env）。.env 里是密钥，只放在自己的机器上，不要外传。
# 下面三项必须填，生成命令：
#   DTK_SECRET_KEY：openssl rand -base64 48   （至少 32 个字符；它加密库里保存的 cookie，丢了就读不出来，和数据库一起备份）
#   两个密码：openssl rand -hex 24
DTK_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 下面两行把密码拼进连接串，保持原样即可（要改成你的值就把上面的密码一起替换）
DTK_DATABASE_URL=postgresql+asyncpg://dtk:${POSTGRES_PASSWORD}@postgres:5432/dtk
DTK_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# 下载器（把视频存到本机，没有它「下载」接口会返回 501）
DTK_DOWNLOADER_URL=http://downloader:9100

DTK_LOG_LEVEL=info
DTK_LOG_JSON=true

# 对外端口，默认只绑定本机 127.0.0.1。要让局域网 / 公网访问请自己加带密码和 HTTPS 的反向代理，不要直接改成 0.0.0.0
DTK_BIND_HOST=127.0.0.1
DTK_BIND_PORT=8000
